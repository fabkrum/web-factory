{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Fixture",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.11,
          0.118
        ],
        "hex": "#1a1c1e"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Public Sans",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        }
      }
    }
  }
}
